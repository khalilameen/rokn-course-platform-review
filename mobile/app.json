{
  "expo": {
    "name": "Rokn",
    "slug": "rokn",
    "version": "1.0.30",
    "icon": "./src/assets/images/brand/rokn-app-icon-1024.png",
    "orientation": "default",
    "scheme": "rokn",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-notifications",
        {
          "color": "#2C69DB",
          "defaultChannel": "rokn-updates"
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "./plugins/withNotificationManifestOverrides",
      "expo-iap"
