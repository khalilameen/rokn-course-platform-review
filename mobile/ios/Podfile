require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, podfile_properties['ios.deploymentTarget'] || min_ios_version_supported
prepare_react_native_project!

# Firebase's Swift SDK is resolved through SPM by React Native Firebase v26 and
# therefore needs dynamic frameworks. Keep the environment override for local
# diagnostics, while release and CI builds use the supported default.
linkage = ENV['USE_FRAMEWORKS'] || 'dynamic'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

# React Native 0.83 owns the concrete RCTEventDispatcher implementation in
# React-CoreModules. react-native-video 6.x still only declares React-Core,
# which leaves its dynamic framework with an unresolved Objective-C class.
# Keep the repair here (instead of editing node_modules) so installs remain
# reproducible and Podfile.lock stays authoritative.
def link_react_native_video_core_modules(installer)
  video_target = installer.pods_project.targets.find { |target| target.name == 'react-native-video' }
  core_modules_target = installer.pods_project.targets.find { |target| target.name == 'React-CoreModules' }

  unless video_target && core_modules_target
    raise Pod::Informative, 'Expected react-native-video and React-CoreModules pod targets were not generated.'
  end

  dependency_exists = video_target.dependencies.any? { |dependency| dependency.target == core_modules_target }
  video_target.add_dependency(core_modules_target) unless dependency_exists

  framework_name = File.basename(core_modules_target.product_reference.path, '.framework')
  video_target.build_configurations.each do |build_config|
    configured_flags = build_config.build_settings['OTHER_LDFLAGS']
    linker_flags = if configured_flags.is_a?(Array)
                     configured_flags.dup
                   elsif configured_flags.nil? || configured_flags.strip.empty?
                     ['$(inherited)']
                   else
                     configured_flags.split
                   end
    linker_flags.push('-framework', framework_name) unless linker_flags.include?(framework_name)
    build_config.build_settings['OTHER_LDFLAGS'] = linker_flags
  end
end

target 'Rokn' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"]
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(\'expo/bin/autolinking\')',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false'
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    link_react_native_video_core_modules(installer)

    # fmt 11.0.2 fails to compile with Xcode 26+ due to stricter consteval checks.
    # Compile fmt as C++17 so FMT_USE_CONSTEVAL stays disabled.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'fmt'

      target.build_configurations.each do |build_config|
        build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      end
    end
  end
end
