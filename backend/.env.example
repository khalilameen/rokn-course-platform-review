APP_NAME=Rokn
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TRUSTED_HOSTS=

# Universal/App Links. Use the SHA-256 fingerprints of every Play signing
# certificate that may install com.rokn, comma separated. Apple values use
# TEAM_ID.bundle_id, for example ABC1234567.com.rokn.
APP_LINK_ANDROID_PACKAGE=com.rokn
APP_LINK_ANDROID_SHA256_FINGERPRINTS=
APP_LINK_APPLE_APP_IDS=
SESSION_SECURE_COOKIE=false
# Production: exact reverse-proxy IPs/CIDRs only; never * or /0.
TRUSTED_PROXIES=
COURSE_ATTACHMENT_SIGNED_URL_MINUTES=30
# Paid-course PDFs must use a private disk shared by every API node. For an
# S3-compatible disk set COURSE_PDF_DISK=s3. For a mounted shared filesystem,
# keep course-pdfs, set an absolute mount path and attest that it is shared.
COURSE_PDF_DISK=course-pdfs
COURSE_PDF_STORAGE_PATH=
COURSE_PDF_SHARED_STORAGE=false
APP_DOMAIN=localhost
APP_TIMEZONE=Africa/Cairo

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

API_READ_IDENTITY_PER_MINUTE=240
API_READ_IP_PER_MINUTE=1200
API_WRITE_IDENTITY_PER_MINUTE=90
API_WRITE_IP_PER_MINUTE=450

# Operational feature controls. Runtime overrides are written audibly with
# `php artisan product:feature`; these values are deployment defaults only.
PRODUCT_FEATURE_TTL_SECONDS=300
PRODUCT_CHECKOUT_ENABLED=true
PRODUCT_PLAYBACK_ENABLED=true
PRODUCT_PROJECT_UPLOADS_ENABLED=true
PRODUCT_AI_CHAT_ENABLED=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rokn
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
FILESYSTEM_PUBLIC_DISK=public
CERTIFICATE_DISK=public
CERTIFICATE_VISIBILITY=public
# CERTIFICATE_FONT_PATH=/absolute/path/to/Cairo.ttf
QUEUE_CONNECTION=sync
WEBHOOK_QUEUE=webhooks
QUEUE_HEARTBEAT_REQUIRED_QUEUES=default,notifications,ai-feedback,webhooks
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Project review fallback (keeps sincere learners moving if an optional evaluator is unavailable)
PROJECT_FALLBACK_REVIEW_DELAY_SECONDS=90
PROJECT_SUBMISSION_DISK=local

# Operations evidence (the dashboard never performs restore actions).
BACKUP_PROVIDER=
BACKUP_LAST_VERIFIED_AT=
RESTORE_DRILL_VERIFIED_AT=
MEDIA_RECONCILE_FETCH_MANIFEST=true
KASHIER_RECONCILE_LOCK_KEY=operations:kashier-reconcile:lock:v1
KASHIER_RECONCILE_LOCK_SECONDS=1800
PROJECT_MINIMUM_TEXT_LENGTH=10
PROJECT_MINIMUM_FILE_BYTES=512
PROJECT_MAXIMUM_FILE_KILOBYTES=25600
PROJECT_IMAGE_INSPECTION_MAX_BYTES=8388608
PROJECT_IMAGE_INSPECTION_MAX_PIXELS=12000000
PROJECT_DARK_IMAGE_THRESHOLD=12
PROJECT_DARK_IMAGE_RATIO=0.97
PROJECT_WHITE_IMAGE_THRESHOLD=248
PROJECT_WHITE_IMAGE_RATIO=0.985
PROJECT_SOLID_IMAGE_LUMINANCE_RANGE=3

# Bunny.net secrets stay on the server. Database secrets entered from the
# dashboard are encrypted; environment variables take precedence.
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
# Optional independent streaming hostname for automatic playback failover.
# Leave blank until a second Bunny pull zone/hostname has been configured.
BUNNY_FALLBACK_CDN_HOSTNAME=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_TOKEN_AUTH_KEY=

# OpenRouter server-side proxy
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_MAX_TOKENS=420
OPENROUTER_PER_MINUTE_LIMIT=8
OPENROUTER_DAILY_USER_LIMIT=100
OPENROUTER_GLOBAL_DAILY_REQUEST_LIMIT=5000
OPENROUTER_GLOBAL_DAILY_TOKEN_BUDGET=2100000
OPENROUTER_GLOBAL_MONTHLY_TOKEN_BUDGET=50000000
OPENROUTER_ANSWER_CACHE_MINUTES=360
# Optional comma-separated allowlist. Empty keeps the model selected in the dashboard.
OPENROUTER_ALLOWED_MODELS=
# Net value of one purchased coin after payment fees/tax, expressed in USD.
# Finance updates this when packages or FX change; it drives plan suggestions only.
ROKN_NET_USD_PER_PAID_COIN=0.001
ROKN_AI_COST_SAFETY_MULTIPLIER=2.0
ROKN_AI_RESERVATION_TTL_SECONDS=120

# Social sign-in is verified server-side. TikTok Login Kit sends its access token here.
SOCIAL_AUTH_TIMEOUT_SECONDS=10
ACCOUNT_DELETION_REAUTH_SECONDS=300
# Generate a long random server-side value and keep it stable across APP_KEY rotation.
REWARD_TOMBSTONE_HMAC_KEY=
# Exact public API prefix used to build start/callback URLs, with no trailing slash.
# Example: https://api.rokn.com/api/v1
SOCIAL_AUTH_PUBLIC_API_URL=
SOCIAL_AUTH_RETURN_URLS=rokn://auth
TIKTOK_USER_INFO_URL=https://open.tiktokapis.com/v2/user/info/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CONNECT_TIMEOUT_SECONDS=3
GOOGLE_TIMEOUT_SECONDS=8
GOOGLE_MAPS_BROWSER_KEY=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Set this explicitly after checking Meta's currently supported Graph API version.
FACEBOOK_GRAPH_VERSION=
WELCOME_BONUS_COINS=20

# Firebase Admin service account used only by the server to deliver opted-in
# push notifications. Do not commit the JSON file itself.
FIREBASE_CREDENTIALS=
FIREBASE_DATABASE_URL=

# Kashier external checkout. Select one mode explicitly and configure the
# matching pair only. Production must use `live`; never ship with `test`.
KASHIER_MODE=live
KASHIER_LIVE_API_KEY=
KASHIER_LIVE_MID=
KASHIER_TEST_API_KEY=
KASHIER_TEST_MID=

# WhatsApp API (Whatspie)
WHATSPIE_API_URL=your_api_url
WHATSPIE_API_KEY=your_api_key
WHATSPIE_DEVICE=your_device
API_TOKEN_ALLOW_LEGACY_PLAINTEXT=false
API_TOKEN_ALLOW_LEGACY_TRANSPORTS=false
SOCIAL_AUTH_ALLOW_LEGACY_PKCE=false
APPLE_CLIENT_ID=
LEARNING_MINIMUM_VERIFIED_SECONDS=20
LEARNING_REQUIRED_WATCH_FRACTION=0.80
LEARNING_MAXIMUM_PLAYBACK_RATE=2.0
LEARNING_MAXIMUM_HEARTBEAT_GAP_SECONDS=45
