{
    "info": {
        "_postman_id": "course-module-api-123",
        "name": "Course Module API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Projects",
            "item": [
                {
                    "name": "Get Project Details",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{api_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/projects/1",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "projects",
                                "1"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Submit Project Evaluation",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{api_token}}",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "score",
                                    "value": "85",
                                    "type": "text"
                                },
                                {
                                    "key": "passed",
                                    "value": "1",
                                    "type": "text"
                                },
                                {
                                    "key": "submission_text",
                                    "value": "My project submission content",
                                    "type": "text"
                                },
                                {
                                    "key": "evaluation_data",
                                    "value": "{\"ai_feedback\": \"Great job!\"}",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/projects/1/evaluate",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "projects",
                                "1",
                                "evaluate"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Get User Project Evaluations for Course",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{api_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/courses/1/project-evaluations",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "courses",
                                "1",
                                "project-evaluations"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Courses",
            "item": [
                {
                    "name": "View Course Details (Modules Structure)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{api_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/view_course/1",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "view_course",
                                "1"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "StudentProgress",
            "item": [
                {
                    "name": "Get Course Progress",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{api_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/course_progress/1",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "course_progress",
                                "1"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:8000",
            "type": "string"
        },
        {
            "key": "api_token",
            "value": "",
            "type": "string"
        }
    ]
}