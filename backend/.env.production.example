APP_NAME=Rokn
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_DOMAIN=example.com
APP_TIMEZONE=Africa/Cairo
APP_TRUSTED_HOSTS=
# Android App Links: comma-separate every SHA-256 signing-certificate
# fingerprint that can install this package (Play App Signing included).
APP_LINK_ANDROID_PACKAGE=com.rokn
APP_LINK_ANDROID_SHA256_FINGERPRINTS=
# Apple Universal Links: comma-separate TEAM_ID.bundle_id values.
APP_LINK_APPLE_APP_IDS=
SESSION_SECURE_COOKIE=true
# Exact Nginx/LB/Cloudflare egress IPs or narrow CIDRs that can reach origin.
# Also restrict the origin firewall to the same list. Never use * or /0.
TRUSTED_PROXIES=10.20.30.0/24
LOG_CHANNEL=stack
LOG_LEVEL=warning

API_READ_IDENTITY_PER_MINUTE=240
API_READ_IP_PER_MINUTE=1200
API_WRITE_IDENTITY_PER_MINUTE=90
API_WRITE_IP_PER_MINUTE=450

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Every web and worker node must use the same Redis service.
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=cache
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=120
WEBHOOK_QUEUE=webhooks
QUEUE_HEARTBEAT_REQUIRED_QUEUES=default,notifications,ai-feedback,webhooks

# Shared files: mount these paths identically on every node. Private project
# submissions and certificates use the shared S3 disk below by default.
SHARED_STORAGE_PATH=/mnt/rokn/storage/app
SHARED_PUBLIC_STORAGE_PATH=/mnt/rokn/storage/app/public
MODULE_ATTACHMENT_STORAGE_PATH=/mnt/rokn/storage/app/module-attachments
COURSE_ATTACHMENT_DISK=module-attachments
COURSE_ATTACHMENT_SIGNED_URL_MINUTES=30
SECURITY_QUARANTINE_PATH=/mnt/rokn/storage/app/security-quarantine
FILESYSTEM_DRIVER=local
FILESYSTEM_PUBLIC_DISK=public
FILESYSTEM_CLOUD=s3
PROJECT_SUBMISSION_DISK=s3
CERTIFICATE_DISK=s3
# Paid course PDFs default to the same private shared object store. If the
# deployment deliberately uses the `course-pdfs` local driver instead, supply
# an absolute shared mount path below and change SHARED_STORAGE to true only
# after every API/worker node mounts and verifies that same durable location.
COURSE_PDF_DISK=s3
COURSE_PDF_STORAGE_PATH=
COURSE_PDF_SHARED_STORAGE=false

# Operations evidence. Update timestamps only after an operator verifies the
# snapshot and completes a restore drill in an isolated environment.
BACKUP_PROVIDER=
BACKUP_LAST_VERIFIED_AT=
RESTORE_DRILL_VERIFIED_AT=
MEDIA_RECONCILE_FETCH_MANIFEST=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=

BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_TOKEN_AUTH_KEY=
# Required in production. Playback fails closed when this signing key is blank.
BUNNY_CONNECT_TIMEOUT_SECONDS=15
BUNNY_UPLOAD_TIMEOUT_SECONDS=3600

KASHIER_MODE=live
KASHIER_LIVE_API_KEY=
KASHIER_LIVE_MID=

OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_ALLOWED_MODELS=
OPENROUTER_MAX_TOKENS=420
OPENROUTER_TIMEOUT_SECONDS=20
OPENROUTER_PER_MINUTE_LIMIT=8
OPENROUTER_DAILY_USER_LIMIT=100
OPENROUTER_GLOBAL_DAILY_REQUEST_LIMIT=5000
OPENROUTER_GLOBAL_DAILY_TOKEN_BUDGET=2100000
OPENROUTER_GLOBAL_MONTHLY_TOKEN_BUDGET=50000000
OPENROUTER_ANSWER_CACHE_MINUTES=360
# Finance must calibrate this from net package receipts after gateway fees,
# taxes and FX. Production preflight fails while it is blank or non-positive.
ROKN_NET_USD_PER_PAID_COIN=
# Must cover provider price movement, retries and normal usage variance.
ROKN_AI_COST_SAFETY_MULTIPLIER=2.0
# Must stay above both the provider request and ai-feedback worker timeouts.
ROKN_AI_RESERVATION_TTL_SECONDS=120

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Required: set the currently supported Meta Graph API version explicitly.
FACEBOOK_GRAPH_VERSION=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CONNECT_TIMEOUT_SECONDS=3
GOOGLE_TIMEOUT_SECONDS=8
GOOGLE_MAPS_BROWSER_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
SOCIAL_AUTH_PUBLIC_API_URL=https://api.example.com/api/v1
SOCIAL_AUTH_RETURN_URLS=rokn://auth
SOCIAL_AUTH_TIMEOUT_SECONDS=10
ACCOUNT_DELETION_REAUTH_SECONDS=300
# Required in production: stable random HMAC key, never a provider ID or user datum.
REWARD_TOMBSTONE_HMAC_KEY=
WELCOME_BONUS_COINS=20

# Path to a secret mounted outside the repository.
FIREBASE_CREDENTIALS=/run/secrets/firebase-service-account.json
FIREBASE_CACHE_STORE=redis

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Rokn

CERTIFICATE_DEEP_LINK_BASE=https://example.com/portfolio
PROJECT_FALLBACK_REVIEW_DELAY_SECONDS=90
PROJECT_MAXIMUM_FILE_KILOBYTES=25600

# Never enable these on a normal production deploy. Publishing demo records
# requires both switches to make the operator's intent explicit.
ROKN_SEED_DEMO=false
ROKN_ALLOW_PRODUCTION_DEMO_SEED=false
API_TOKEN_ALLOW_LEGACY_PLAINTEXT=false
API_TOKEN_ALLOW_LEGACY_TRANSPORTS=false
SOCIAL_AUTH_ALLOW_LEGACY_PKCE=false
APPLE_CLIENT_ID=
LEARNING_MINIMUM_VERIFIED_SECONDS=20
LEARNING_REQUIRED_WATCH_FRACTION=0.80
LEARNING_MAXIMUM_PLAYBACK_RATE=2.0
LEARNING_MAXIMUM_HEARTBEAT_GAP_SECONDS=45
